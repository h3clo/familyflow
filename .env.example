# Optional. App works fully offline with local storage until these are set.
# Create a NEW Supabase project (separate from Haze Flow), then fill:
# See docs/SUPABASE_SETUP.md
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public publishable/anon key ONLY — never service_role
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
