# Optional. App works fully offline with local storage until these are set.
# Create a NEW Supabase project (separate from Haze Flow), then fill:
# See docs/SUPABASE_SETUP.md
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public publishable/anon key ONLY — never service_role

# Optional — live Supabase QA (never commit real passwords). See docs/SUPABASE_QA.md
# SUPABASE_QA_URL=https://YOUR_QA_PROJECT.supabase.co
# SUPABASE_QA_PUBLISHABLE_KEY=
# SUPABASE_QA_USER_A_EMAIL=
# SUPABASE_QA_USER_A_PASSWORD=
# SUPABASE_QA_USER_B_EMAIL=
# SUPABASE_QA_USER_B_PASSWORD=
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
